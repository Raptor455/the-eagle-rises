{
  "name": "the-eagle-rises",
  "version": "0.1.0",
  "private": true,
  "description": "Batailles napoléoniennes en 3D : première démo, plateau de Pratzen (Austerlitz)",
  "main": "appli/main.js",
  "scripts": {
    "assembler": "node outils/assembler.js",
    "meshy": "node outils/meshy/generer.mjs",
    "exe": "npm run assembler && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "meshoptimizer": "^1.3.0",
    "three": "^0.180.0"
  },
  "build": {
    "appId": "com.raptor455.theeaglerises",
    "productName": "The Eagle Rises",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "appli/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "The Eagle Rises.exe"
    }
  }
}
